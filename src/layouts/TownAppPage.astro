---
import TownBlogApp from '../components/TownBlogApp';
import { siteConfig } from '../config/site';
import type { TownLayout } from '../data/town-layout';
import type { TownPostSummary } from '../components/TownScene';
import type { ArticleSection } from '../lib/markdown';
import '../styles/global.css';
import '../styles/markdown.css';

interface Props {
  posts: TownPostSummary[];
  layout?: TownLayout;
  initialSurface: 'town' | 'archive' | 'article';
  initialPostId?: string;
  initialPostContent?: ArticleSection[];
}

const { posts, layout, initialSurface, initialPostId, initialPostContent } = Astro.props;
const selectedPost = initialPostId ? posts.find((post) => post.id === initialPostId) : undefined;
const pageTitle = selectedPost ? `${selectedPost.title} · ${siteConfig.title}` : initialSurface === 'archive' ? `全部文章 · ${siteConfig.title}` : siteConfig.title;
const description = selectedPost?.description ?? siteConfig.description;
const canonical = selectedPost
  ? new URL(`/posts/${encodeURIComponent(selectedPost.id)}/`, siteConfig.siteUrl)
  : new URL(initialSurface === 'archive' ? '/posts/' : '/', siteConfig.siteUrl);
const cover = selectedPost?.cover ? new URL(selectedPost.cover, siteConfig.siteUrl) : new URL(siteConfig.logo, siteConfig.siteUrl);
const jsonLd = selectedPost
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: selectedPost.title,
      description: selectedPost.description,
      datePublished: selectedPost.date,
      dateModified: selectedPost.updatedAt ?? selectedPost.date,
      author: { '@type': 'Person', name: siteConfig.profile.name, url: siteConfig.siteUrl },
      image: cover.href,
      mainEntityOfPage: canonical.href,
      articleSection: selectedPost.category,
      keywords: selectedPost.tags.join(', '),
      wordCount: selectedPost.wordCount,
      timeRequired: `PT${selectedPost.readingTime}M`,
      inLanguage: siteConfig.language,
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: siteConfig.title,
      alternateName: siteConfig.shortTitle,
      url: siteConfig.siteUrl,
      description: siteConfig.description,
      inLanguage: siteConfig.language,
      author: { '@type': 'Person', name: siteConfig.profile.name, url: siteConfig.siteUrl },
    };
const jsonLdText = JSON.stringify(jsonLd).replace(/</g, '\\u003c');
---
<html lang={siteConfig.language} data-initial-surface={initialSurface}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <script is:inline>
      // Apply before the first paint; React continues following the same preference.
      const dark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.classList.toggle('mode-night', dark);
      document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
      document.querySelector('meta[name="theme-color"]').setAttribute('content', dark ? '#0b1220' : '#ffffff');
    </script>
    <meta name="description" content={description} />
    <meta name="author" content={siteConfig.profile.name} />
    <meta property="og:type" content={selectedPost ? 'article' : 'website'} />
    <meta property="og:site_name" content={siteConfig.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={cover} />
    <meta property="og:image:alt" content={selectedPost?.coverAlt ?? siteConfig.title} />
    {selectedPost && <meta property="article:published_time" content={selectedPost.date} />}
    {selectedPost && <meta property="article:modified_time" content={selectedPost.updatedAt ?? selectedPost.date} />}
    {selectedPost && <meta property="article:section" content={selectedPost.category} />}
    {selectedPost?.tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={cover} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={`${siteConfig.title} · RSS`} href={new URL('/rss.xml', siteConfig.siteUrl)} />
    <link rel="sitemap" type="application/xml" href={new URL('/sitemap.xml', siteConfig.siteUrl)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{pageTitle}</title>
    <script id="page-jsonld" is:inline type="application/ld+json" set:html={jsonLdText}></script>
    {initialSurface === 'town' && <link rel="preload" href="/assets/brick-town/studio.env" as="fetch" crossorigin="anonymous" />}
    <script>
      import '../scripts/town-startup';
    </script>
  </head>
  <body><TownBlogApp client:load posts={posts} layout={layout} initialSurface={initialSurface} initialPostId={initialPostId} initialPostContent={initialPostContent} /></body>
</html>
