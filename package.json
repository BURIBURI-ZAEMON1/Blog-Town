{
  "name": "town-blog-framework",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "verify:spatial": "node scripts/verify-town-spatial.mjs",
    "verify": "npm run check && npm run build && npm run verify:content && npm run verify:spatial && npm run verify:life && npm run verify:brick && npm run verify:seasons",
    "verify:content": "node scripts/verify-content.mjs",
    "verify:life": "node scripts/verify-town-life.mjs",
    "verify:brick": "node scripts/verify-brick-town.mjs",
    "verify:seasons": "node scripts/verify-town-seasons.mjs"
  },
  "dependencies": {
    "@astrojs/react": "6.0.4",
    "@babylonjs/core": "^9.25.0",
    "@babylonjs/materials": "^9.25.0",
    "@fontsource-variable/bodoni-moda": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@fontsource/zcool-qingke-huangyou": "^5.3.0",
    "@ibm/plex-sans-sc": "^1.1.0",
    "astro": "^7.2.8",
    "marked": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanitize-html": "2.17.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/sanitize-html": "2.16.0",
    "playwright": "1.62.1",
    "typescript": "6.0.3"
  },
  "description": "A customizable Astro blog framework presented as an interactive brick town."
}
