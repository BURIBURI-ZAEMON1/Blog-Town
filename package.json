{
  "name": "town-blog-framework",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "new": "node scripts/new-post.mjs",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "verify": "npm run check && npm run build && npm run verify:content && npm run verify:seasons && npm run verify:markdown && npm run verify:rss",
    "verify:content": "node scripts/verify-content.mjs",
    "verify:seasons": "node scripts/verify-town-seasons.mjs",
    "verify:markdown": "node scripts/verify-markdown.mjs",
    "verify:rss": "node scripts/verify-rss.mjs"
  },
  "dependencies": {
    "@astrojs/react": "6.0.4",
    "@astrojs/rss": "4.0.19",
    "@babylonjs/core": "^9.25.0",
    "@babylonjs/materials": "^9.25.0",
    "@fontsource-variable/bodoni-moda": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@fontsource/zcool-qingke-huangyou": "^5.3.0",
    "@ibm/plex-sans-sc": "^1.1.0",
    "@mathjax/mathjax-newcm-font": "^4.1.3",
    "@mathjax/src": "^4.1.3",
    "astro": "^7.2.8",
    "dom-serializer": "2.0.0",
    "entities": "^8.1.0",
    "htmlparser2": "8.0.2",
    "marked": "16.3.0",
    "pele": "^1.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanitize-html": "2.17.7",
    "sharp": "0.35.5",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "^26.6.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/sanitize-html": "2.16.0",
    "typescript": "6.0.3"
  },
  "description": "A customizable Astro blog framework presented as an interactive brick town."
}
